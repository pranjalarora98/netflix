generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Video {
  id        String   @id @default(uuid())
  status    String   @default("pending")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videoId   String   @unique

  @@index([status])
  @@index([createdAt])
}
